# Release imzalama şablonu.
# Bu dosyayı "keystore.properties" adıyla kopyalayın ve kendi değerlerinizle doldurun.
# Gerçek keystore.properties ve .jks dosyaları .gitignore ile repo dışında tutulur.
#
# Keystore üretmek için (bir kez):
#   keytool -genkeypair -v -keystore yolarkadasim-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias yolarkadasim
#
storeFile=../yolarkadasim-release.jks
storePassword=DEĞİŞTİRİN
keyAlias=yolarkadasim
keyPassword=DEĞİŞTİRİN
