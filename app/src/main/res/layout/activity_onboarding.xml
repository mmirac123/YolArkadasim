<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/textOnboardingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/onboarding_title"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingMultiplier="1.1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/textOnboardingTitle"
        app:layout_constraintBottom_toTopOf="@id/btnOnboardingContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textOnboardingBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_body"
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            android:lineSpacingMultiplier="1.15" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOnboardingContinue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:minHeight="80dp"
        android:text="@string/onboarding_button"
        android:textColor="@color/surface_dark"
        android:textSize="22sp"
        android:textStyle="bold"
        android:contentDescription="@string/cd_onboarding_button"
        app:backgroundTint="@color/accent_green"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
